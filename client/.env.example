# Base URL of the Flask Backend Server
# In production (e.g., Vercel), set this to your public backend URL or Cloudflare/ngrok HTTPS tunnel URL.
# Example: https://my-camera-soc.trycloudflare.com or https://camera-api.onrender.com
# In local development, leave empty or set to http://localhost:5000
VITE_API_URL=http://localhost:5000
